# Agent Video Studio — 环境变量模板
# 复制本文件为 .env 并填入真实值
# 警告：.env 文件已被 .gitignore 排除，绝不提交真实密钥

# ── 转写 Provider（可选）────────────────────────────────────────────
# 支持：whisper_cpp | openai_whisper | disabled | manual
AVS_TRANSCRIPTION_PROVIDER=disabled
# OPENAI_API_KEY=sk-...

# ── TTS Provider（可选）─────────────────────────────────────────────
# V1 默认禁用
AVS_TTS_PROVIDER=disabled

# ── 项目路径（通常不需要修改）────────────────────────────────────────
# AVS_PROJECT_ROOT=.

# ── 日志级别────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
AVS_LOG_LEVEL=INFO
