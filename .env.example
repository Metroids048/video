# Agent Video Studio — 环境变量模板
# 复制本文件为 .env 并填入真实值
# 警告：.env 文件已被 .gitignore 排除，绝不提交真实密钥

# ── 转写 Provider（可选）────────────────────────────────────────────
# 支持：whisper_cpp | openai_whisper | disabled | manual
# 默认推荐：项目免费 faster-whisper（见 scripts/free_providers/）
AVS_TRANSCRIPTION_PROVIDER=disabled
# OPENAI_API_KEY=sk-...

# ── TTS Provider（可选）─────────────────────────────────────────────
# V1 默认禁用；免费默认可用 Edge TTS。付费升级见下方。
AVS_TTS_PROVIDER=disabled

# ── 可选付费 / 云端升级（按 docs/video-plugin-routing.md）────────────
# ElevenLabs（高品质配音；默认可不配）
# ELEVENLABS_API_KEY=

# Azure Speech（明确要求 Azure TTS/STT 时）
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# Seedance / Kie（生成式视频；默认用 seedance-free）
# KIE_API_KEY=
# SEEDANCE_API_KEY=

# Epidemic Sound：通过官方 MCP 登录，勿把 Cookie/Token 写入本文件或仓库
# MCP: https://www.epidemicsound.com/a/mcp-service/mcp

# ── 项目路径（通常不需要修改）────────────────────────────────────────
# AVS_PROJECT_ROOT=.

# ── 日志级别────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
AVS_LOG_LEVEL=INFO
