{
  "name": "creator-os",
  "version": "2.0.0",
  "description": "Creator OS V2 publish-ready creator production runtime",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap-check.mjs && pwsh -NoProfile -File scripts/bootstrap.ps1",
    "doctor": "node scripts/run-python.mjs -m avs doctor",
    "demo": "node scripts/run-python.mjs scripts/run_e2e_demo.py --all",
    "demo:reference": "node scripts/run-python.mjs scripts/run_e2e_demo.py --mode reference",
    "demo:screen": "node scripts/run-python.mjs scripts/run_e2e_demo.py --mode screen",
    "verify": "node scripts/verify.mjs",
    "test": "node scripts/run-python.mjs -m pytest -q",
    "lint": "node scripts/run-python.mjs -m ruff check src tests scripts",
    "typecheck": "node scripts/run-python.mjs -m mypy src",
    "lock:python": "node scripts/run-python.mjs scripts/lock_python_deps.py",
    "skills:install": "node scripts/install_skills.mjs",
    "skills:sync": "node scripts/run-python.mjs scripts/sync_skills.py",
    "skills:check": "node scripts/run-python.mjs scripts/sync_skills.py --check",
    "skills:vendor": "node scripts/run-python.mjs scripts/vendor_video_skills.py",
    "skills:vendor:check": "node scripts/run-python.mjs scripts/vendor_video_skills.py --check",
    "skills:ensure": "node scripts/run-python.mjs scripts/ensure_video_plugins.py",
    "skills:diagnose": "node scripts/run-python.mjs scripts/diagnose_video_plugins.py",
    "skills:overlays": "node scripts/run-python.mjs scripts/apply_free_provider_overlays.py"
  },
  "devDependencies": {
    "gsap": "^3.14.2",
    "hyperframes": "0.7.90"
  }
}
