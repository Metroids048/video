{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "episode.schema.json",
  "title": "Episode",
  "description": "单期视频的状态与元数据",
  "type": "object",
  "required": ["id", "mode", "publishable", "status", "platforms", "completed_stages", "created_at", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{1,63}$",
      "description": "Episode唯一标识，大写字母数字连字符"
    },
    "mode": {
      "type": "string",
      "enum": ["REFERENCE_CLONE", "REFERENCE_ADAPT", "ORIGINAL"],
      "description": "制作模式"
    },
    "input_mode": {
      "type": "string",
      "enum": ["multimodal", "screenshot_intro"],
      "description": "Active 输入路线；screenshot_intro 允许先生成待审阅的截图图文预览"
    },
    "production_type": {
      "type": "string",
      "enum": ["STANDARD", "SCREEN_DOCUMENTARY"],
      "default": "STANDARD",
      "description": "制作类型；SCREEN_DOCUMENTARY 启用真实录屏与 Pilot Gate 硬约束"
    },
    "publishable": {
      "type": "boolean",
      "description": "是否允许生成发布包；REFERENCE_CLONE 强制为 false"
    },
    "status": {
      "type": "string",
      "enum": [
        "CREATED",
        "INGESTED",
        "REFERENCE_READY",
        "CONTENT_READY",
        "ASSETS_READY",
        "TIMELINE_READY",
        "PILOT_APPROVED",
        "ROUGH_CUT_READY",
        "QA_PASSED",
        "DELIVERY_READY",
        "WAITING_FOR_INPUT",
        "WAITING_FOR_REVIEW",
        "BLOCKED",
        "FAILED"
      ]
    },
    "platforms": {
      "type": "array",
      "items": {"type": "string", "enum": ["douyin", "xiaohongshu"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "completed_stages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["ingest", "reference", "content", "assets", "analyze", "story-mine", "direct", "screen-plan", "pilot", "pilot-review", "pilot-revise", "plan", "voice-audition", "voice-lock", "preview", "visual-review", "final-render", "approve", "timeline", "rough_cut", "qa", "delivery", "export"]
      },
      "uniqueItems": true
    },
    "last_error": {
      "type": ["string", "null"],
      "description": "最后一次失败原因"
    },
    "blocked": {
      "type": "boolean",
      "description": "主动阻塞标记；需要人工修复后才能继续"
    },
    "blocked_stage": {
      "type": ["string", "null"],
      "enum": [
        null,
        "ingest",
        "analyze",
        "story-mine",
        "direct",
        "screen-plan",
        "pilot",
        "pilot-review",
        "pilot-revise",
        "plan",
        "preview",
        "visual-review",
        "final-render",
        "qa",
        "approve",
        "delivery",
        "export"
      ],
      "description": "当前暂停且必须重新执行的 Active 阶段；null 表示没有阶段级暂停"
    },
    "artifacts": {
      "type": "object",
      "description": "已生成产物路径表（键为产物名，值为相对路径）",
      "additionalProperties": {"type": "string"}
    },
    "title": {
      "type": ["string", "null"],
      "description": "视频标题（内容模块填写）"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "创建时间，带时区 ISO 8601"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "最后更新时间，带时区 ISO 8601"
    }
  }
}
