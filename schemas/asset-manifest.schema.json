{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "asset-manifest.schema.json",
  "title": "AssetManifest",
  "description": "素材清单",
  "type": "object",
  "required": ["episode_id", "generated_at", "assets"],
  "additionalProperties": false,
  "properties": {
    "episode_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "source_path", "working_path", "kind", "mime_type", "sha256", "status"],
        "additionalProperties": true,
        "properties": {
          "asset_id": {"type": "string"},
          "source_path": {"type": "string"},
          "working_path": {"type": ["string", "null"]},
          "kind": {"type": "string", "enum": ["video", "audio", "image", "document", "text", "link", "unknown"]},
          "mime_type": {"type": "string"},
          "duration": {"type": ["number", "null"]},
          "width": {"type": ["integer", "null"]},
          "height": {"type": ["integer", "null"]},
          "fps": {"type": ["number", "null"]},
          "has_audio": {"type": ["boolean", "null"]},
          "codec_video": {"type": ["string", "null"]},
          "codec_audio": {"type": ["string", "null"]},
          "layout": {"type": ["string", "null"], "enum": ["contain", "cover", "layout", null]},
          "duplicate_of": {"type": ["string", "null"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "status": {"type": "string", "enum": ["ok", "missing", "corrupt", "unsupported"]},
          "notes": {"type": ["string", "null"]}
        }
      }
    }
  }
}
