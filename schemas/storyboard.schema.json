{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "storyboard.schema.json",
  "title": "Storyboard",
  "description": "分镜与素材缺口（必须追溯到 script 和 creative-profile）",
  "type": "object",
  "required": ["episode_id", "shots", "generated_at", "traceability"],
  "additionalProperties": false,
  "properties": {
    "episode_id": {"type": "string"},
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene_id", "script_segment_ids", "duration", "visual_type", "asset_ids", "caption", "motion_template", "missing_assets", "notes"],
        "additionalProperties": false,
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "script_segment_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "duration": {"type": "number", "exclusiveMinimum": 0},
          "visual_type": {"type": "string", "enum": ["screen_recording", "image", "video", "b_roll", "motion_graphic", "placeholder"]},
          "asset_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "caption": {"type": "string"},
          "motion_template": {"type": ["string", "null"], "enum": ["HookTitle", "InfoCard", "EndCard", null]},
          "missing_assets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "notes": {"type": ["string", "null"]}
        }
      },
      "minItems": 1
    },
    "asset_gaps": {
      "type": "array",
      "items": {"type": "string"},
      "description": "缺少素材的 shot_id 列表"
    },
    "traceability": {
      "type": "object",
      "required": ["script_sha256", "creative_profile_sha256"],
      "properties": {
        "script_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "script.json 的 SHA-256 哈希"
        },
        "creative_profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "creative-profile.json 的 SHA-256 哈希"
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
