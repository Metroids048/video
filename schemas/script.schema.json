{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "script.schema.json",
  "title": "Script",
  "description": "口播脚本（必须追溯到 brief 和 creative-profile）",
  "type": "object",
  "required": ["episode_id", "segments", "generated_at", "traceability"],
  "additionalProperties": false,
  "properties": {
    "episode_id": {"type": "string"},
    "total_duration_estimate": {"type": ["number", "null"]},
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "text", "purpose", "target_duration", "visual_hint", "source_refs", "status"],
        "additionalProperties": false,
        "properties": {
          "segment_id": {"type": "string"},
          "text": {"type": "string"},
          "purpose": {"type": "string"},
          "target_duration": {"type": "number", "exclusiveMinimum": 0},
          "visual_hint": {"type": "string", "minLength": 1},
          "source_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "uniqueItems": true
          },
          "status": {"type": "string", "enum": ["draft", "reviewed", "approved"]},
          "notes": {"type": ["string", "null"]}
        }
      },
      "minItems": 1
    },
    "traceability": {
      "type": "object",
      "required": ["brief_sha256", "creative_profile_sha256"],
      "properties": {
        "brief_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "brief.json 的 SHA-256 哈希"
        },
        "creative_profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "creative-profile.json 的 SHA-256 哈希"
        },
        "reference_ids": {
          "type": "array",
          "items": {"type": "string"},
          "description": "参考资料 IDs，如 REF-001"
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
