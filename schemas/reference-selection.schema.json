{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reference-selection.schema.json",
  "title": "Reference pattern selection",
  "type": "object",
  "required": ["episode_id", "selections"],
  "additionalProperties": false,
  "properties": {
    "episode_id": {"type": "string"},
    "selections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pattern_id", "applies_to", "reason"],
        "additionalProperties": false,
        "properties": {
          "pattern_id": {"type": "string", "pattern": "^PAT-[0-9]{3}$"},
          "applies_to": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
