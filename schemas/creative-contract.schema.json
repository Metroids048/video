{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative-contract.schema.json",
  "title": "Creator OS V2 Creative Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "episode_id", "target_platforms", "audience", "story", "primary_conflict", "hook", "viewer_payoff", "format", "evidence_refs", "voice_mode", "visual_direction", "definition_of_done"],
  "properties": {
    "version": {"const": "2.0"},
    "episode_id": {"type": "string", "minLength": 2},
    "target_platforms": {"type": "array", "minItems": 1, "items": {"enum": ["douyin", "xiaohongshu"]}, "uniqueItems": true},
    "audience": {"type": "string", "minLength": 1},
    "story": {"type": "string", "minLength": 1},
    "primary_conflict": {"type": "string", "minLength": 1},
    "hook": {"type": "string", "minLength": 1},
    "viewer_payoff": {"type": "string", "minLength": 1},
    "format": {"enum": ["VIDEO", "CAROUSEL", "TEXT"]},
    "target_duration_seconds": {"type": ["number", "null"], "minimum": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reference_recipe_refs": {"type": "array", "items": {"type": "string"}},
    "voice_mode": {"enum": ["HUMAN_ENHANCED", "HYBRID_S2S", "PREMIUM_TTS", "NONE"]},
    "visual_direction": {"type": "string", "minLength": 1},
    "privacy_rules": {"type": "array", "items": {"type": "string"}},
    "definition_of_done": {"type": "string", "minLength": 1},
    "contract_version": {"type": "integer", "minimum": 1}
  }
}
