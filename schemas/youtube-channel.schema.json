{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avs.local/schemas/youtube-channel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "canonical_url", "discovered_at", "public_video_count", "extractor_version"],
  "properties": {
    "source": {"type": "string", "const": "youtube"},
    "channel_id": {"type": ["string", "null"]},
    "handle": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "canonical_url": {"type": "string", "format": "uri"},
    "uploads_playlist_id": {"type": ["string", "null"]},
    "discovered_at": {"type": "string", "format": "date-time"},
    "public_video_count": {"type": "integer", "minimum": 0},
    "extractor_version": {"type": "string", "minLength": 1}
  }
}
