{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "shot-plan.schema.json",
  "title": "Deterministic shot plan",
  "type": "object",
  "required": ["episode_id", "shots", "excluded_assets"],
  "additionalProperties": false,
  "properties": {
    "episode_id": {"type": "string"},
    "shots": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "excluded_assets": {"type": "array", "items": {"type": "object"}},
    "analysis_asset_ids": {"type": "array", "items": {"type": "string"}}
  }
}
